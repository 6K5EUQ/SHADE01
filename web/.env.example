# web/.env — 서버에만 둔다. 리포는 public 이므로 커밋 금지 (.gitignore 에 있다).
# cp .env.example .env 후 값을 채운다.

# 업로드 공유 암호. 비우면 업로드가 아예 막힌다 (조회는 계속 공개).
#   openssl rand -base64 18
UPLOAD_PASSWORD=

# 듣는 포트. cloudflared ingress 의 값과 같아야 한다.
PORT=4300

# 루프백만. 터널 뒤에 있으므로 밖으로 열 이유가 없다.
BIND_ADDR=127.0.0.1

# 업로드 원본·캐시가 사는 곳. **워크트리 밖**에 둔다 —
# git clean -fdx 한 번에 업로드가 사라지는 경로를 만들지 않는다.
DATA_DIR=/home/ku/shade01-data
LOG_DIR=/home/ku/shade01-data/logs

# pyulog·numpy 가 있는 파이썬. 서버에는 시스템 pip 이 없어 venv 를 따로 만든다.
QGCLOG_PYTHON=/home/ku/shade01-venv/bin/python

# 업로드 상한(바이트)과 파싱 타임아웃(ms). 실측 최악이 0.5초라 60초면 충분하다.
MAX_UPLOAD=67108864
PARSE_TIMEOUT=60000
MAX_JOBS=3

# 라이브 중계 인증. 현장 노트북(rim3)의 livepush.py 가 같은 값을 갖고 POST 한다
# (rim3 쪽은 ~/.config/shade-live.env). 비우면 /api/live/push 가 막힌다 —
# 조회(/live)는 계속 공개다.
#   openssl rand -base64 24
LIVE_PUSH_KEY=

# 재생 백엔드(mav_live.py)가 듣는 포트. server.js 가 /api/playback/* 을 여기로
# 넘긴다. 유닛은 shade-playback.service, 기본 4401.
SHADE_PLAYBACK_PORT=4401
