[Unit]
# ELRS 백팩 깨우기. `./qgc live on` 이 트래커와 **같이** 띄우고, 그 뒤로는
# 계속 떠 있는다 — AP 가 없으면 스스로 기다리다가 올라오면 다시 붙는다.
# (예전에는 AP 가 있을 때만 띄웠다. 그러면 나중에 AP 를 켰을 때 아무도 안
#  깨워서 조용했다.)
#
# 백팩은 먼저 말을 걸어온 곳에만 텔레메트리를 보낸다 — 트래커는 읽기 전용이라
# 스스로 못 깨운다. 그 한 가지 일만 이 유닛이 한다.
# 나가는 것은 빈 하트비트뿐이다 (명령 아님) — web/live/backpack_poke.py 참조.
Description=SHADE01 ELRS backpack poker (heartbeat only)
After=network.target

# 🔴 재시작 제한을 걸지 않는다. WiFi 를 껐다 켰다 하는 운용에서 1분에 세 번
#    죽으면 systemd 가 영영 포기하는데, 이 스크립트는 AP 가 없어도 죽지 않게
#    돼 있으므로 제한이 득보다 실이 크다.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-%h/.config/shade-live.env
ExecStart=%h/SHADE01/.venv/bin/python %h/SHADE01/web/live/backpack_poke.py
# 백팩 AP 에서 떨어져도 스크립트가 스스로 계속 재시도하므로 죽지 않는다.
# 그래도 예외로 죽으면 되살린다 — always 인 이유는 어떤 이유로 끝나든
# 다시 떠 있어야 하기 때문이다.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
