#!/usr/bin/env bash
# 라이브 트래킹 페이지를 띄운다.
#
#   ./web/live/live              14550 에서 듣는다 (백팩·브리지 공용)
#   ./web/live/live 14551        다른 포트로
#
# 읽기 전용이다 — FC 로 나가는 바이트가 없다. 조작은 QGC 로 한다.
#
# ELRS 백팩으로 볼 때: 먼저 ./gcs/qgroundcontrol/elrs-backpack 으로 AP 에
# 붙어야 한다 (그 스크립트가 QGC 도 같이 띄운다). WiFi 가 없는 ku 에서는
# shade-bridge 경로로만 볼 수 있다.

set -eu

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PY="${QGCLOG_PYTHON:-$REPO/.venv/bin/python}"
# 인자가 우선, 없으면 환경변수, 그것도 없으면 기본값.
# systemd 유닛은 인자를 못 주므로(ExecStart 고정) 환경변수 경로가 필요하다.
PORT="${1:-${LIVE_UDP:-14550}}"
HTTP="${LIVE_HTTP:-4400}"
# 바인딩 주소. 기본은 모든 인터페이스지만, 백팩 경로에서는 WiFi 주소에만
# 못박아 shade-bridge(Tailscale 주소)와 같은 포트를 나눠 쓴다.
BIND="${LIVE_BIND:-0.0.0.0}"

if [[ ! -x "$PY" ]]; then
  echo "python venv 이 없다: $PY" >&2
  echo "PROCEDURE.md '2-0 분석 PC 준비' 를 따라 만들어라:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -r web/requirements.txt" >&2
  exit 1
fi

# pymavlink 가 없으면 파이썬 트레이스백만 남는다. 무엇을 깔아야 하는지 말해 준다.
if ! "$PY" -c "import pymavlink" 2>/dev/null; then
  echo "pymavlink 이 없다 ($PY)." >&2
  echo "  .venv/bin/pip install -r web/requirements.txt" >&2
  exit 1
fi

# 포트가 이미 쓰이고 있으면 미리 알려준다. 안 그러면 bind 실패 메시지만 뜬다.
# 특정 주소에 못박아 열 때는 다른 주소의 같은 포트와 안 부딪힌다 — 그때
# 경고를 띄우면 거짓말이다 (shade-bridge 는 Tailscale 주소에만 바인딩한다).
if [[ "$BIND" == "0.0.0.0" ]] && ss -ulnp 2>/dev/null | grep -q ":${PORT}\b"; then
  echo "⚠️  UDP ${PORT} 를 이미 누가 쓰고 있다:"
  ss -ulnp 2>/dev/null | grep ":${PORT}\b" | sed 's/^/    /'
  echo "    QGC 나 shade-bridge 다. 그쪽을 끄거나 다른 포트를 써라: $0 14551"
  echo
fi

echo "브라우저: http://localhost:${HTTP}"
exec "$PY" "$REPO/web/live/mav_live.py" --port "$PORT" --http "$HTTP" --bind "$BIND"
