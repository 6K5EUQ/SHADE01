# cp hosts.conf.example hosts.conf 후 채운다. hosts.conf 는 커밋하지 않는다
# (리포가 public 이라 인프라 주소를 넣지 않는다).
#
# Tailscale 이름을 쓰면 IP 를 안 적어도 된다.

# 로그를 가진 개발 PC 들
SOURCES=(
  "ku@ku-dgs1"
  "rim3@rim3"      # IP 로는 22 번이 안 열린다 — 이름을 쓴다
  "rim@rim"        # 계정명이 rim 이다 (Tailscale 소유자 태그는 yyrrm@ 이지만 무관)
)

# 정본 보관소 (웹 서버)
SERVER="ku@ku-labserver"
SERVER_LOGS="/home/ku/shade01-data/logs"
PUBLIC_URL="https://shade01.bewe.co.kr"

# FC 가 USB 로 붙어 있는 PC — ./qgc sync 가 여기서 MAVFTP 로 받는다.
# FC 를 다른 PC 로 옮기면 이 줄만 바꾼다 (2026-09-04 에 raspb1 → rim3 로 옮겼다).
FC_HOST="rim3@rim3"
FC_VENV="~/.venv-mav/bin/python"   # 그 PC 의 pymavlink 인터프리터
FC_LOGDIR="~/SHADE01/logs"         # 그 PC 가 받아 둘 곳
