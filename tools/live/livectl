#!/usr/bin/env bash
# 실시간 트래킹 페이지를 켜고 끈다. `./qgc live ...` 가 여기로 온다.
#
#   ./qgc live on          켠다 (기본 UDP 14550 / 웹 4400)
#   ./qgc live on 14551    UDP 포트를 지정해 켠다
#   ./qgc live always      켜고 + 부팅 때도 자동으로 뜨게 (재부팅해도 산다)
#   ./qgc live off         끈다 (부팅 자동시작도 같이 뗀다)
#   ./qgc live status      상태
#   ./qgc live log         최근 로그
#   ./qgc live install     systemd --user 유닛 설치 (최초 1회, 자동으로도 된다)
#
# systemd --user 로 돌린다. 터미널을 닫아도 살아 있어야 하기 때문이다 —
# 비행 중에 창이 닫혔다고 화면이 죽으면 곤란하다.
#
# 🔴 읽기 전용이다. FC 로 나가는 바이트가 없다 — web/live/README.md 「상행이 없다」.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
UNIT=shade-live.service
UNIT_SRC="$HERE/web/live/shade-live.service"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/shade-live.env"
HTTP_PORT="${LIVE_HTTP:-4400}"

die() { echo "$*" >&2; exit 1; }

have_systemd() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

install_unit() {
  [[ -f "$UNIT_SRC" ]] || die "유닛 파일이 없다: $UNIT_SRC"
  mkdir -p "$UNIT_DIR"
  # 항상 리포의 것으로 덮는다. 유닛을 고쳤는데 옛것이 남아 있으면 헷갈린다.
  if ! cmp -s "$UNIT_SRC" "$UNIT_DIR/$UNIT"; then
    cp "$UNIT_SRC" "$UNIT_DIR/$UNIT"
    systemctl --user daemon-reload
    echo "유닛 설치: $UNIT_DIR/$UNIT"
  fi
}

# 포트가 이미 쓰이고 있는지. 우리 유닛이 쥔 것은 제외한다.
port_taken_by_other() {
  local port="$1" own_pid
  own_pid="$(systemctl --user show -p MainPID --value "$UNIT" 2>/dev/null || echo 0)"
  ss -ulnp 2>/dev/null | grep -E "[:.]${port}\b" | grep -qv "pid=${own_pid:-0},"
}

# $2 가 'always' 면 부팅 자동시작까지 건다.
cmd_on() {
  local udp="${1:-}" persist="${2:-}"
  have_systemd || die "systemd --user 를 쓸 수 없다. 직접 띄워라:  ./web/live/live ${udp:-}"
  install_unit

  # 포트를 환경파일에 적는다. 유닛을 안 고치고 바꿀 수 있게.
  mkdir -p "$(dirname "$ENV_FILE")"
  if [[ -n "$udp" ]]; then
    printf 'LIVE_UDP=%s\nLIVE_HTTP=%s\n' "$udp" "$HTTP_PORT" > "$ENV_FILE"
  else
    printf 'LIVE_HTTP=%s\n' "$HTTP_PORT" > "$ENV_FILE"
  fi

  local want="${udp:-14550}"
  if port_taken_by_other "$want"; then
    echo "⚠️  UDP $want 를 이미 누가 쓰고 있다:"
    ss -ulnp 2>/dev/null | grep -E "[:.]${want}\b" | sed 's/^/    /'
    echo "    QGC 나 shade-bridge 다. 그쪽을 끄거나 다른 포트로 켜라:"
    echo "      ./qgc live on 14551"
    echo
  fi

  systemctl --user reset-failed "$UNIT" 2>/dev/null || true
  systemctl --user restart "$UNIT"

  # 뜨는 데 잠깐 걸린다. 실패면 바로 알려준다.
  sleep 1.2
  if ! systemctl --user is-active --quiet "$UNIT"; then
    echo "❌ 시작 실패. 최근 로그:" >&2
    journalctl --user -u "$UNIT" -n 15 --no-pager 2>/dev/null | sed 's/^/    /' >&2
    exit 1
  fi

  if [[ "$persist" == "always" ]]; then
    # enable 만으로는 부족하다 — 로그인 세션이 없는 동안에도 유닛이 돌려면
    # linger 가 켜져 있어야 한다. 둘 다 있어야 "재부팅해도 산다" 가 성립한다.
    systemctl --user enable "$UNIT" >/dev/null 2>&1 || true
    if ! loginctl show-user "$(whoami)" 2>/dev/null | grep -q 'Linger=yes'; then
      loginctl enable-linger "$(whoami)" >/dev/null 2>&1 || true
    fi
    local ling
    ling=$(loginctl show-user "$(whoami)" 2>/dev/null | grep -c 'Linger=yes' || true)
    if [[ "$ling" == "1" ]]; then
      echo "✅ 라이브 트래킹 ON (항상)   http://localhost:${HTTP_PORT}"
      echo "   부팅해도 자동으로 뜬다 — enable + linger 둘 다 걸렸다"
    else
      echo "✅ 라이브 트래킹 ON   http://localhost:${HTTP_PORT}"
      echo "   ⚠️  linger 를 못 켰다 — 로그아웃하면 죽는다. 직접 실행하라:"
      echo "       sudo loginctl enable-linger $(whoami)"
    fi
    echo "   UDP ${want} 수신 · 읽기 전용 (FC 로 아무것도 안 보낸다)"
    echo "   끄기: ./qgc live off  (부팅 자동시작도 같이 떼어진다)"
    return
  fi

  echo "✅ 라이브 트래킹 ON   http://localhost:${HTTP_PORT}"
  echo "   UDP ${want} 수신 · 읽기 전용 (FC 로 아무것도 안 보낸다)"
  echo "   끄기: ./qgc live off"
}

cmd_off() {
  have_systemd || die "systemd --user 를 쓸 수 없다. 직접 띄운 프로세스는 Ctrl-C 로 끝내라."
  if systemctl --user is-active --quiet "$UNIT"; then
    systemctl --user stop "$UNIT"
    echo "⏹  라이브 트래킹 OFF"
  else
    echo "이미 꺼져 있다."
  fi
  # 부팅 시 자동 시작이 걸려 있으면 같이 뗀다 — off 는 off 여야 한다.
  # 다만 **말은 하고** 뗀다. 조용히 지우면 `always` 로 걸어 둔 PC 가 다음 부팅에
  # 안 뜨는데 아무도 그 이유를 모른다 (ku 에서 실제로 그랬다).
  if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; then
    systemctl --user disable "$UNIT" >/dev/null 2>&1 || true
    echo "   부팅 자동시작도 해제했다 — 다시 걸려면: ./qgc live always"
  fi
}

cmd_status() {
  have_systemd || die "systemd --user 를 쓸 수 없다."
  if systemctl --user is-active --quiet "$UNIT"; then
    local udp=14550
    [[ -f "$ENV_FILE" ]] && udp="$(grep -oP '(?<=^LIVE_UDP=).*' "$ENV_FILE" 2>/dev/null || echo 14550)"
    local persist=""
    systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null && persist="  · 부팅 자동시작"
    echo "● ON    http://localhost:${HTTP_PORT}   (UDP ${udp})${persist}"
    # 실제로 프레임이 들어오는지까지 본다. 켜져만 있고 링크가 없는 경우가 흔하다.
    if command -v curl >/dev/null 2>&1; then
      curl -s --max-time 2 "http://127.0.0.1:${HTTP_PORT}/api/state" 2>/dev/null \
        | python3 -c "
import json,sys
try: s=json.load(sys.stdin)
except Exception: sys.exit()
d=s.get('d',{})
live=s.get('live'); age=s.get('age')
print('  링크: %s   패킷 %s   %s' % (
    '수신 중' if live else ('끊김 (%.0f초 전)' % age if age is not None else '없음'),
    format(s.get('packets',0),','), s.get('src') or '-'))
# 링크가 끊기면 아래 값은 **마지막으로 받은 값**이다. 지금 상태가 아니다 —
# 비행 중에 옛 고도를 현재값으로 읽으면 위험하다.
if d:
    print('  %s모드 %s   %s   고도 %.1fm' % (
        '' if live else '(마지막) ',
        d.get('mode','?'), 'ARMED' if d.get('armed') else 'DISARMED', d.get('alt') or 0))
" 2>/dev/null || true
    fi
  else
    echo "○ OFF"
    systemctl --user is-failed --quiet "$UNIT" 2>/dev/null && {
      echo "  (직전 실행이 실패했다 — ./qgc live log)"; }
  fi
}

case "${1:-}" in
  on)      shift; cmd_on "${1:-}" ;;
  always)  shift; cmd_on "${1:-}" always ;;
  off)     cmd_off ;;
  status)  cmd_status ;;
  log)     journalctl --user -u "$UNIT" -n "${2:-40}" --no-pager ;;
  install) install_unit; echo "설치 완료. 켜기: ./qgc live on" ;;
  ""|-h|--help|help)
    cat >&2 <<'USAGE'
사용법:
  ./qgc live on [UDP포트]   실시간 트래킹 켜기 (기본 14550, 웹 localhost:4400)
  ./qgc live always [포트]  켜고 + 부팅 때도 자동으로 (재부팅해도 산다)
  ./qgc live off            끄기 (부팅 자동시작도 같이 뗀다)
  ./qgc live status         상태 + 링크 수신 여부
  ./qgc live log [줄수]     로그
  ./qgc live install        systemd 유닛만 설치

읽기 전용이다 — FC 로 아무것도 보내지 않는다. 조작은 QGC 로 한다.
USAGE
    exit 1 ;;
  *) die "알 수 없는 하위명령: $1  (on|always|off|status|log|install)" ;;
esac
