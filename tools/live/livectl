#!/usr/bin/env bash
# 실시간 트래킹 페이지를 켜고 끈다. `./qgc live ...` 가 여기로 온다.
#
#   ./qgc live on          켠다 (기본 UDP 14550 / 웹 4400)
#   ./qgc live on 14551    UDP 포트를 지정해 켠다
#   ./qgc live always      켜고 + 부팅 때도 자동으로 뜨게 (재부팅해도 산다)
#   ./qgc live off         끈다 (부팅 자동시작도 같이 뗀다)
#   ./qgc live status      상태
#   ./qgc live log         최근 로그
#   ./qgc live install     systemd --user 유닛 설치 (최초 1회, 자동으로도 된다)
#
# systemd --user 로 돌린다. 터미널을 닫아도 살아 있어야 하기 때문이다 —
# 비행 중에 창이 닫혔다고 화면이 죽으면 곤란하다.
#
# 🔴 읽기 전용이다. FC 로 나가는 바이트가 없다 — web/live/README.md 「상행이 없다」.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
UNIT=shade-live.service
UNIT_SRC="$HERE/web/live/shade-live.service"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/shade-live.env"
HTTP_PORT="${LIVE_HTTP:-4400}"
POKE_UNIT=shade-backpack.service
POKE_SRC="$HERE/web/live/shade-backpack.service"
# 웹 중계. 🔴 현장 노트북(rim3)에서만 의미가 있다 — FC 가 붙는 PC 가 거기다.
PUSH_UNIT=shade-livepush.service
PUSH_SRC="$HERE/web/live/shade-livepush.service"

# 백팩 AP 주소. 붙어 있으면 이 IP 가 응답한다.
BACKPACK_IP="${BACKPACK_IP:-10.0.0.1}"

die() { echo "$*" >&2; exit 1; }

have_systemd() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

install_unit() {
  [[ -f "$UNIT_SRC" ]] || die "유닛 파일이 없다: $UNIT_SRC"
  mkdir -p "$UNIT_DIR"
  # 항상 리포의 것으로 덮는다. 유닛을 고쳤는데 옛것이 남아 있으면 헷갈린다.
  local changed=0
  if ! cmp -s "$UNIT_SRC" "$UNIT_DIR/$UNIT"; then
    cp "$UNIT_SRC" "$UNIT_DIR/$UNIT"; changed=1
    echo "유닛 설치: $UNIT_DIR/$UNIT"
  fi
  if [[ -f "$POKE_SRC" ]] && ! cmp -s "$POKE_SRC" "$UNIT_DIR/$POKE_UNIT"; then
    cp "$POKE_SRC" "$UNIT_DIR/$POKE_UNIT"; changed=1
    echo "유닛 설치: $UNIT_DIR/$POKE_UNIT"
  fi
  if [[ -f "$PUSH_SRC" ]] && ! cmp -s "$PUSH_SRC" "$UNIT_DIR/$PUSH_UNIT"; then
    cp "$PUSH_SRC" "$UNIT_DIR/$PUSH_UNIT"; changed=1
    echo "유닛 설치: $UNIT_DIR/$PUSH_UNIT"
  fi
  [[ $changed -eq 1 ]] && systemctl --user daemon-reload || true
}

# FC 가 이 PC 에 꽂혀 있나 — 시리얼 장치 파일이 하나라도 있으면 그렇다.
#
# 🔴 `ls /dev/ttyACM* /dev/ttyUSB*` 로 쓰지 마라. 둘 중 **한쪽 글롭만 안 맞아도**
#    ls 가 exit 2 를 낸다 — ttyACM0 이 멀쩡히 있는데도 "없다" 가 된다
#    (실측 rim3 2026-09-06). 셸에게 글롭을 직접 물어야 한다.
fc_usb_present() {
  local f
  for f in /dev/ttyACM* /dev/ttyUSB*; do
    [[ -e "$f" ]] && return 0
  done
  return 1
}

# 백팩 AP 에 붙어 있나. 붙어 있으면 10.0.0.1 이 ping 에 답한다.
backpack_up() { ping -c1 -W1 "$BACKPACK_IP" >/dev/null 2>&1; }

# 지금 트래커가 실제로 무엇을 받고 있나 — 'USB' · 'ELRS' · 빈 문자열.
# 트래커가 보낸 쪽 주소로 이미 갈라 `link` 에 넣어 준다.
current_link() {
  systemctl --user is-active --quiet "$UNIT" 2>/dev/null || return 0
  command -v curl >/dev/null 2>&1 || return 0
  local js
  js="$(curl -s --max-time 2 "http://127.0.0.1:${HTTP_PORT}/api/state?track=0" 2>/dev/null || true)"
  printf '%s' "$js" | grep -q '"live": true' || return 0
  printf '%s' "$js" | grep -oE '"link"[[:space:]]*:[[:space:]]*"[A-Za-z]+"' \
    | grep -oE '"[A-Za-z]+"$' | tr -d '"' || true
}

# 포트가 이미 쓰이고 있는지. 우리 유닛이 쥔 것은 제외한다.
port_taken_by_other() {
  local port="$1" own_pid
  own_pid="$(systemctl --user show -p MainPID --value "$UNIT" 2>/dev/null || echo 0)"
  ss -ulnp 2>/dev/null | grep -E "[:.]${port}\b" | grep -qv "pid=${own_pid:-0},"
}

# $2 가 'always' 면 부팅 자동시작까지 건다.
cmd_on() {
  local udp="${1:-}" persist="${2:-}"
  have_systemd || die "systemd --user 를 쓸 수 없다. 직접 띄워라:  ./web/live/live ${udp:-}"
  install_unit

  # 🔴 경로를 **고르지 않는다.** 둘 다 열어 두고 트래커가 살아 있는 쪽을
  #    쓰게 한다 (둘 다면 ELRS 우선 — mav_live.py 의 LINK_PRIORITY).
  #
  #    예전에는 여기서 하나를 골라 그 포트로만 열었다. 그래서 USB 를 뽑고
  #    백팩으로 갈아탈 때마다 `./qgc live on` 을 다시 돌려야 했고, 안 돌리면
  #    옛 포트에 그대로 앉아 조용했다. 이제 갈아타는 데 아무것도 안 해도 된다.
  # 🔴 브리지 경로 포트는 **PC 마다 다르다.** rim3 은 shade-bridge 자신이
  #    14550 을 쥐고 있어 트래커가 14551 로 비켜 앉고, 브리지가 거기로도
  #    복사본을 보낸다 (pc_bridge.sh 의 TARGETS 에 127.0.0.1:14551).
  #    그래서 인자로 안 주면 **지난번에 쓰던 포트를 그대로 쓴다** — 매번
  #    14550 으로 되돌리면 그 PC 는 켤 때마다 조용해진다.
  local want="$udp"
  if [[ -z "$want" && -f "$ENV_FILE" ]]; then
    want="$(grep -oP '(?<=^LIVE_UDP=).*' "$ENV_FILE" 2>/dev/null | head -1 || true)"
  fi
  want="${want:-14550}"

  # 🔴 백팩은 여기서 **찾지 않는다.** 트래커가 3초마다 스스로 보고 붙는 대로
  #    열고, 떠나면 닫는다 (mav_live.py 의 Listeners). 여기서 정하면 `on` 을
  #    친 그 순간의 상태로 굳어서, AP 를 나중에 켜면 또 `on` 을 쳐야 했다.
  #    그것을 없애는 게 이번 작업의 목적이다.
  # 🔴 이 파일을 통째로 덮어쓰지 마라. 여기에는 우리가 정하는 값(LIVE_UDP 등)
  #    말고 **손으로 넣은 것**도 산다 — LIVE_PUSH_KEY 가 그렇다. 덮어쓰면
  #    `on` 을 칠 때마다 웹 중계가 조용히 죽는다 (실측 2026-09-06).
  #    우리가 관리하는 줄만 갈아 끼우고 나머지는 그대로 둔다.
  mkdir -p "$(dirname "$ENV_FILE")"
  {
    grep -vE '^(LIVE_UDP|LIVE_HTTP|LIVE_LISTEN|LIVE_BIND)=' "$ENV_FILE" 2>/dev/null || true
    printf 'LIVE_UDP=%s\n' "$want"
    printf 'LIVE_HTTP=%s\n' "$HTTP_PORT"
    printf 'LIVE_LISTEN=%s\n' "$want"
  } > "$ENV_FILE.tmp"
  mv -f "$ENV_FILE.tmp" "$ENV_FILE"

  # 브리지 경로 포트가 남에게 잡혀 있으면 미리 말해 준다. 백팩 쪽은 주소에
  # 못박으므로 안 부딪힌다.
  if port_taken_by_other "$want"; then
    echo "⚠️  UDP $want 를 이미 누가 쓰고 있다:"
    ss -ulnp 2>/dev/null | grep -E "[:.]${want}\b" | sed 's/^/    /'
    echo "    QGC 나 shade-bridge 다. 그쪽을 끄거나 다른 포트로 켜라:"
    echo "      ./qgc live on 14551"
    echo
  fi

  systemctl --user reset-failed "$UNIT" 2>/dev/null || true
  systemctl --user restart "$UNIT"

  # 뜨는 데 잠깐 걸린다. 실패면 바로 알려준다.
  sleep 1.2
  if ! systemctl --user is-active --quiet "$UNIT"; then
    echo "❌ 시작 실패. 최근 로그:" >&2
    journalctl --user -u "$UNIT" -n 15 --no-pager 2>/dev/null | sed 's/^/    /' >&2
    exit 1
  fi

  # ── 무엇을 듣는지 알려 준다.
  echo "   수신: 0.0.0.0:${want}  (USB 직결/브리지)"
  echo "         ELRS 백팩 — AP 가 올라오면 알아서 붙는다"

  # 🔴 poker 는 **언제나** 띄운다. AP 가 없어도 죽지 않고 기다리다가 올라오면
  #    스스로 포트를 다시 묻고 깨우기 시작한다. 예전에는 AP 가 있을 때만
  #    띄웠는데, 그러면 나중에 조종기를 켰을 때 아무도 안 깨워서 조용했다.
  systemctl --user reset-failed "$POKE_UNIT" 2>/dev/null || true
  systemctl --user restart "$POKE_UNIT" 2>/dev/null || true

  # 웹 중계는 키가 있을 때만 띄운다. 키가 없는 PC 에서 띄우면 403 만 찍는다.
  if grep -q '^LIVE_PUSH_KEY=.' "$ENV_FILE" 2>/dev/null; then
    systemctl --user reset-failed "$PUSH_UNIT" 2>/dev/null || true
    systemctl --user restart "$PUSH_UNIT" 2>/dev/null || true
    echo "   웹 중계: shade01.bewe.co.kr/live 로 올린다"
  else
    systemctl --user stop "$PUSH_UNIT" 2>/dev/null || true
  fi

  # 지금 실제로 무엇이 들어오는지까지 본다. 켜졌다는 것과 데이터가 온다는
  # 것은 다른 말이다.
  # ⚠️ 여기서 `return` 하지 마라 — 아래 `always` 블록(enable + linger)을
  #    통째로 건너뛴다. 링크가 붙어 있을 때만 조용히 안 걸리는 버그가 된다.
  local now_link; now_link="$(current_link)"
  if [[ -n "$now_link" ]]; then
    echo "   지금 링크: ${now_link}"
  else
    # 아직 아무것도 안 들어온다. **왜** 안 들어오는지까지 말해 준다 —
    # "링크 없음" 만으로는 무엇을 고쳐야 할지 알 수 없다.
    echo "   ⚠️  아직 아무것도 안 들어온다"
    if fc_usb_present; then
      # FC 는 꽂혀 있는데 아무도 UDP 로 안 밀어주고 있다. 브리지가 그 일을 한다.
      if ! systemctl --user is-active --quiet shade-bridge 2>/dev/null; then
        echo "       FC 는 꽂혀 있는데 shade-bridge 가 꺼져 있다:"
        echo "         systemctl --user start shade-bridge"
      else
        echo "       FC 도 브리지도 있다 — 브리지가 이 포트로도 보내는지 보라"
        echo "         (pc_bridge.sh 의 TARGETS 에 127.0.0.1:${want})"
      fi
    elif backpack_up; then
      echo "       백팩 AP 에는 붙어 있다 — 조종기가 켜져 있고 기체와 링크됐는지 보라"
    else
      echo "       FC USB 도 없고 백팩 AP 에도 안 붙어 있다"
      echo "       (조종기를 켜면 알아서 붙는다 — 이 명령을 다시 칠 필요는 없다)"
    fi
  fi

  if [[ "$persist" == "always" ]]; then
    # enable 만으로는 부족하다 — 로그인 세션이 없는 동안에도 유닛이 돌려면
    # linger 가 켜져 있어야 한다. 둘 다 있어야 "재부팅해도 산다" 가 성립한다.
    systemctl --user enable "$UNIT" >/dev/null 2>&1 || true
    # poker 도 같이 부팅에 건다. AP 가 없는 동안은 조용히 기다릴 뿐이라
    # 켜 둬서 손해가 없고, 켜 둬야 조종기를 켰을 때 저절로 붙는다.
    systemctl --user enable "$POKE_UNIT" >/dev/null 2>&1 || true
    if grep -q '^LIVE_PUSH_KEY=.' "$ENV_FILE" 2>/dev/null; then
      systemctl --user enable "$PUSH_UNIT" >/dev/null 2>&1 || true
    else
      systemctl --user disable "$PUSH_UNIT" >/dev/null 2>&1 || true
    fi
    if ! loginctl show-user "$(whoami)" 2>/dev/null | grep -q 'Linger=yes'; then
      loginctl enable-linger "$(whoami)" >/dev/null 2>&1 || true
    fi
    local ling
    ling=$(loginctl show-user "$(whoami)" 2>/dev/null | grep -c 'Linger=yes' || true)
    if [[ "$ling" == "1" ]]; then
      echo "✅ 라이브 트래킹 ON (항상)   http://localhost:${HTTP_PORT}"
      echo "   부팅해도 자동으로 뜬다 — enable + linger 둘 다 걸렸다"
    else
      echo "✅ 라이브 트래킹 ON   http://localhost:${HTTP_PORT}"
      echo "   ⚠️  linger 를 못 켰다 — 로그아웃하면 죽는다. 직접 실행하라:"
      echo "       sudo loginctl enable-linger $(whoami)"
    fi
    echo "   UDP ${want} 수신 · 읽기 전용 (FC 로 아무것도 안 보낸다)"
    echo "   끄기: ./qgc live off  (부팅 자동시작도 같이 떼어진다)"
    return
  fi

  echo "✅ 라이브 트래킹 ON   http://localhost:${HTTP_PORT}"
  echo "   UDP ${want} 수신 · 읽기 전용 (FC 로 아무것도 안 보낸다)"
  echo "   끄기: ./qgc live off"
}

cmd_off() {
  have_systemd || die "systemd --user 를 쓸 수 없다. 직접 띄운 프로세스는 Ctrl-C 로 끝내라."
  systemctl --user stop "$POKE_UNIT" 2>/dev/null || true
  systemctl --user disable "$POKE_UNIT" >/dev/null 2>&1 || true
  systemctl --user stop "$PUSH_UNIT" 2>/dev/null || true
  systemctl --user disable "$PUSH_UNIT" >/dev/null 2>&1 || true
  if systemctl --user is-active --quiet "$UNIT"; then
    systemctl --user stop "$UNIT"
    echo "⏹  라이브 트래킹 OFF"
  else
    echo "이미 꺼져 있다."
  fi
  # 부팅 시 자동 시작이 걸려 있으면 같이 뗀다 — off 는 off 여야 한다.
  # 다만 **말은 하고** 뗀다. 조용히 지우면 `always` 로 걸어 둔 PC 가 다음 부팅에
  # 안 뜨는데 아무도 그 이유를 모른다 (ku 에서 실제로 그랬다).
  if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; then
    systemctl --user disable "$UNIT" >/dev/null 2>&1 || true
    echo "   부팅 자동시작도 해제했다 — 다시 걸려면: ./qgc live always"
  fi
}

cmd_status() {
  have_systemd || die "systemd --user 를 쓸 수 없다."
  if systemctl --user is-active --quiet "$UNIT"; then
    local udp=14550
    [[ -f "$ENV_FILE" ]] && udp="$(grep -oP '(?<=^LIVE_UDP=).*' "$ENV_FILE" 2>/dev/null || echo 14550)"
    local persist=""
    systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null && persist="  · 부팅 자동시작"
    local via=""
    systemctl --user is-active --quiet "$POKE_UNIT" 2>/dev/null && via="  · 백팩 깨우는 중"
    systemctl --user is-active --quiet "$PUSH_UNIT" 2>/dev/null && via="${via}  · 웹 중계 중"
    echo "● ON    http://localhost:${HTTP_PORT}   (UDP ${udp})${persist}${via}"
    # 실제로 프레임이 들어오는지까지 본다. 켜져만 있고 링크가 없는 경우가 흔하다.
    if command -v curl >/dev/null 2>&1; then
      curl -s --max-time 2 "http://127.0.0.1:${HTTP_PORT}/api/state" 2>/dev/null \
        | python3 -c "
import json,sys
try: s=json.load(sys.stdin)
except Exception: sys.exit()
d=s.get('d',{})
live=s.get('live'); age=s.get('age')
print('  링크: %s   패킷 %s   %s%s' % (
    '수신 중' if live else ('끊김 (%.0f초 전)' % age if age is not None else '없음'),
    format(s.get('packets',0),','), s.get('src') or '-',
    '  [%s]' % s['link'] if s.get('link') else ''))
# 두 경로를 동시에 듣는다. 둘 다 붙어 있으면 둘 다 보여 준다 —
# 화면이 쓰는 것은 위의 [경로] 하나뿐이다 (둘 다면 ELRS 우선).
lk = s.get('links') or {}
if len(lk) > 1:
    print('  붙어 있는 경로: %s' % '  '.join(
        '%s(%.0f초 전)' % (k, v) for k, v in sorted(lk.items())))
# 링크가 끊기면 아래 값은 **마지막으로 받은 값**이다. 지금 상태가 아니다 —
# 비행 중에 옛 고도를 현재값으로 읽으면 위험하다.
if d:
    print('  %s모드 %s   %s   고도 %.1fm' % (
        '' if live else '(마지막) ',
        d.get('mode','?'), 'ARMED' if d.get('armed') else 'DISARMED', d.get('alt') or 0))
" 2>/dev/null || true
    fi
  else
    echo "○ OFF"
    systemctl --user is-failed --quiet "$UNIT" 2>/dev/null && {
      echo "  (직전 실행이 실패했다 — ./qgc live log)"; }
  fi
}

case "${1:-}" in
  on)      shift; cmd_on "${1:-}" ;;
  always)  shift; cmd_on "${1:-}" always ;;
  off)     cmd_off ;;
  status)  cmd_status ;;
  log)     journalctl --user -u "$UNIT" -n "${2:-40}" --no-pager ;;
  install) install_unit; echo "설치 완료. 켜기: ./qgc live on" ;;
  ""|-h|--help|help)
    cat >&2 <<'USAGE'
사용법:
  ./qgc live on [UDP포트]   실시간 트래킹 켜기 (기본 14550, 웹 localhost:4400)
  ./qgc live always [포트]  켜고 + 부팅 때도 자동으로 (재부팅해도 산다)
  ./qgc live off            끄기 (부팅 자동시작도 같이 뗀다)
  ./qgc live status         상태 + 링크 수신 여부
  ./qgc live log [줄수]     로그
  ./qgc live install        systemd 유닛만 설치

읽기 전용이다 — FC 로 아무것도 보내지 않는다. 조작은 QGC 로 한다.
USAGE
    exit 1 ;;
  *) die "알 수 없는 하위명령: $1  (on|always|off|status|log|install)" ;;
esac
