#!/usr/bin/env bash
# 비행 끝나고 한 줄. FC → 이 PC → shade01.bewe.co.kr.
#
#   ./qgc sync              오늘(KST) 비행을 받아 올린다
#   ./qgc sync 2026-09-05   그날 것
#   ./qgc sync --dry        무엇을 받고 올릴지 보여주기만
#   ./qgc sync --all        서버 기준 증분을 무시하고 FC 전체를 훑는다
#   ./qgc sync --verify     5회씩 받아 바이트 다수결로 복원 (느리지만 정확)
#
# 왜 이게 있나: 손으로 하면 브리지 정지 → fcfetch → 브리지 복구 → scp →
# 판정 → 업로드 → 서비스 재시작이 일곱 단계다. 하나만 빠뜨려도(특히 **브리지
# 복구**) QGC 링크가 끊긴 채 남는다. 여기서는 어떻게 끝나든 복구가 돈다.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
LOCAL="$REPO/logs"

# ── 설정 ────────────────────────────────────────────────────────────
# 🔴 리포가 public 이라 주소를 여기 적지 않는다. web/tools/hosts.conf 에 적는다.
CONF="$REPO/web/tools/hosts.conf"
[ -f "$CONF" ] || { echo "설정이 없다: $CONF"; echo "  cp $REPO/web/tools/hosts.conf.example $CONF"; exit 1; }
# shellcheck disable=SC1090
. "$CONF"

: "${SERVER:?hosts.conf 에 SERVER 가 없다}"
FC_HOST="${FC_HOST:-rim3@rim3}"                 # FC 가 USB 로 붙어 있는 PC
FC_VENV="${FC_VENV:-~/.venv-mav/bin/python}"    # 그 PC 의 pymavlink 인터프리터
FC_LOGDIR="${FC_LOGDIR:-~/SHADE01/logs}"        # 그 PC 가 받아 둘 곳
SERVER_LOGS="${SERVER_LOGS:-/home/ku/shade01-data/logs}"
PUBLIC_URL="${PUBLIC_URL:-https://shade01.bewe.co.kr}"
SERVER_UNIT="${SERVER_UNIT:-lab-shade01}"

# 이 크기 미만은 **받지도 않는다.** 재연결이 파일당 7.7초라 총시간의 72% 를
# 먹는 것이 실측이므로(2026-09-05: 49개 562초 중 377초), 받는 개수를 줄이는
# 것이 유일하게 듣는 최적화다. FC 는 한 연결에 파일 하나만 내주므로 병렬은
# 불가능하다 (PROCEDURE.md "FC 는 한 연결에 파일 하나만 내준다").
#
# ⚠️ 1.0MB 근거 — 2026-09-05 실측 49개:
#      실비행·호버 8개  = 1.17 ~ 22.41 MB   (전부 위)
#      지상·즉시disarm  = 0.19 ~ 0.95 MB    (하나 빼고 전부 아래)
#    경계에 가장 가까운 것은 지상 로그 0.95MB 다. 호버 최소는 1.17MB 였다.
#    아슬아슬하면 --min-size 로 낮춰라. 건너뛴 것 중 **가장 큰 크기를 항상
#    출력**하므로, 경계에 붙은 파일이 있었는지 눈으로 확인할 수 있다.
MIN_MB="${SYNC_MIN_MB:-1.0}"

# 서버에 올릴 배지. 사용자가 보려는 것은 실제로 뜬 비행이다.
UPLOAD_BADGES="${SYNC_BADGES:-flight hover}"

# 0 이면 한 번만 받는다. N>=3 이면 N 번 받아 **바이트 다수결**로 복원한다.
#
# 🔴 FC 가 SD 를 읽을 때마다 다른 바이트를 낸다 — 512바이트 섹터 단위로,
#    한 번 읽을 때 2278섹터 중 7~14개(약 1.4%)가 어긋난다 (2026-09-06 실측).
#    어긋나는 섹터가 매번 다르므로 다수결이 원본을 되살린다. 5회면 충분한 것을
#    leave-one-out 으로 확인했고, 서로 다른 두 시행이 바이트 단위로 같은 결과를
#    냈다. 복원본의 CRC 는 FC 자신이 낸 값 중 하나와 일치했다.
#    근거: FLIGHT-SYNC.md · tools/qgclog/fcvote.py
#
# ⚠️ 받는 시간이 N 배가 된다. 기본은 꺼 둔다 — 켜는 것은 정확도가 필요할 때다.
VOTE_N="${SYNC_VOTE:-0}"

DRY=0; DATE=""; ALL=0
for a in "$@"; do
  case "$a" in
    --dry) DRY=1 ;;
    --min-size=*) MIN_MB="${a#*=}" ;;
    --all-badges) UPLOAD_BADGES="flight hover ground noarm unknown" ;;
    --all) ALL=1 ;;
    --verify) VOTE_N=5 ;;
    --verify=*) VOTE_N="${a#*=}" ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    -*) echo "모르는 옵션: $a"; exit 1 ;;
    *) DATE="$a" ;;
  esac
done

# 날짜 폴더는 **UTC** 다 (FC 가 그렇게 만든다).
#
# 기본 동작은 **서버 기준 증분**이다 — 정본 보관소가 가진 마지막 로그보다 뒤인
# 것만 받는다. 날짜를 인자로 주면 그 폴더만 보고, `--all` 이면 자르지 않는다.
#
# 왜 서버가 기준인가: 로컬 `logs/` 는 PC 마다 다르고 지웠다 받았다 한다.
# **서버는 한 곳이고 정본**이라, "무엇까지 반영됐나" 를 물어볼 곳이 거기뿐이다.
CUTOFF=""
if [ -n "$DATE" ]; then
  DIRS=("$DATE")
elif [ "$ALL" = 1 ]; then
  DIRS=()            # 아래에서 FC 의 폴더 전부를 읽는다
else
  DIRS=()
fi

say() { printf '%s\n' "$*"; }
fail() { printf '✗ %s\n' "$*" >&2; }

# ── 브리지 ──────────────────────────────────────────────────────────
# FC 시리얼 포트는 하나뿐이다. 브리지가 잡고 있으면 MAVFTP 가 못 붙는다.
# 유닛이 --user 인지 시스템인지는 PC 마다 다르다 (rim3=user, raspb1=system).
BRIDGE_SCOPE=""
bridge_detect() {
  if ssh -o BatchMode=yes -o ConnectTimeout=20 "$FC_HOST" \
       'systemctl --user is-active shade-bridge.service >/dev/null 2>&1'; then
    BRIDGE_SCOPE="user"; BRIDGE_UNIT="shade-bridge.service"
  elif ssh -o BatchMode=yes -o ConnectTimeout=20 "$FC_HOST" \
       'systemctl is-active mavlink-bridge.service >/dev/null 2>&1'; then
    BRIDGE_SCOPE="system"; BRIDGE_UNIT="mavlink-bridge.service"
  else
    BRIDGE_SCOPE="none"
  fi
}
bridge() {   # bridge start|stop
  case "$BRIDGE_SCOPE" in
    user)   ssh -o BatchMode=yes -o ConnectTimeout=30 "$FC_HOST" "systemctl --user $1 $BRIDGE_UNIT" ;;
    system) ssh -o BatchMode=yes -o ConnectTimeout=30 "$FC_HOST" "sudo systemctl $1 $BRIDGE_UNIT" ;;
    *)      return 0 ;;
  esac
}

# 🔴 어떻게 끝나든 브리지를 되살린다. 이걸 빠뜨리면 QGC 무선 링크가 끊긴 채
#    남고, 다음 사람이 원인을 모른 채 기체 앞에 선다.
STOPPED=0
restore() {
  [ "$STOPPED" = 1 ] || return 0
  # 🔴 **출력보다 먼저** 상태를 내린다. 아래 어느 줄에서 죽어도 두 번 돌지 않는다.
  STOPPED=0
  # 🔴 복구는 출력에 의존하면 안 된다. 파이프가 끊긴 상태(`| head`)에서 트랩이
  #    돌면, 여기서 stdout 에 쓰는 순간 SIGPIPE 를 또 맞아 **ssh 를 부르기도 전에
  #    죽는다** — 실측으로 물렸다. 그래서 신호를 막고, 쓰기 실패를 전부 삼킨다.
  trap '' PIPE HUP
  bridge start >/dev/null 2>&1
  local ok=$?
  { [ "$ok" = 0 ] && printf '  ✅ 브리지 복구\n' \
                  || printf '✗ 브리지 복구 실패 — 손으로: ssh %s '"'"'systemctl --user start shade-bridge.service'"'"'\n' "$FC_HOST"; } 2>/dev/null || true
}
# 🔴 PIPE 를 빠뜨리면 안 된다. 출력을 `| head` 로 받는 순간 SIGPIPE 로 죽는데,
#    그때 EXIT 트랩이 안 돌아 **브리지가 내려간 채 남는다** — 실측으로 물렸다.
#    HUP 은 ssh 세션이 끊길 때 온다.
trap restore EXIT INT TERM HUP PIPE

# ── 1. FC 목록 ──────────────────────────────────────────────────────
say "== FC 로그 목록 =="
bridge_detect
if [ "$BRIDGE_SCOPE" = "none" ]; then
  say "  (브리지 유닛 없음 — 포트가 비어 있다고 보고 진행)"
else
  bridge stop && STOPPED=1
  say "  브리지 정지 ($BRIDGE_SCOPE/$BRIDGE_UNIT) — QGC 링크가 잠시 끊긴다"
fi

scp -q -o BatchMode=yes -o ConnectTimeout=60 \
    "$REPO/tools/qgclog/fcfetch.py" "$REPO/tools/qgclog/fcvote.py" "$FC_HOST:/tmp/" || {
  fail "fcfetch.py 전송 실패"; exit 1; }

# ── 서버 기준 증분 ──────────────────────────────────────────────────
# 정본 보관소가 가진 **마지막 로그의 UTC 시각**을 구한다. 그보다 뒤인 것만 받는다.
#
# ⚠️ 서버 API 의 `utc` 필드는 이름과 달리 **KST** 다. 그래서 API 가 아니라
#    **파일명**으로 계산한다 — 파일명이 FC 경로와 같은 기준(UTC)이라 변환이
#    한 번뿐이다. 두 이름 형식의 시간대가 다른 것은 since.py 가 다룬다.
if [ -z "$DATE" ] && [ "$ALL" != 1 ]; then
  srvnames=$(ssh -n -o BatchMode=yes -o ConnectTimeout=30 "$SERVER" \
             "ls '$SERVER_LOGS'/*.ulg 2>/dev/null | xargs -rn1 basename" 2>/dev/null)
  if [ -z "$srvnames" ]; then
    say "  서버가 비어 있다 — FC 전체를 훑는다"
  else
    CUTOFF=$(printf '%s\n' "$srvnames" | python3 "$HERE/since.py" cutoff)
    if [ -n "$CUTOFF" ]; then
      # ⚠️ `date -d "<t> UTC +9 hours"` 는 오프셋을 두 번 먹어 9시간이 더 간다.
      #    TZ 로 변환시킨다 — 실측으로 09-05 18:34 를 09-06 03:34 로 찍었다.
      say "  서버 마지막 로그: $CUTOFF UTC (KST $(TZ=Asia/Seoul date -d "$CUTOFF UTC" '+%m-%d %H:%M' 2>/dev/null))"
    fi
  fi
fi

# 훑을 폴더를 정한다. 인자로 날짜를 줬으면 그것만, 아니면 FC 의 폴더 목록에서
# cutoff 날짜 이후만 고른다 — 폴더 하나 훑는 데 왕복이 한 번씩 들기 때문이다.
if [ ${#DIRS[@]} -eq 0 ]; then
  root=$(ssh -n -o BatchMode=yes -o ConnectTimeout=60 "$FC_HOST" \
         "cd /tmp && $FC_VENV fcfetch.py ls" 2>&1)
  if ! grep -q 'err=0' <<< "$root"; then
    fail "FC 폴더 목록을 못 읽었다"
    printf '%s\n' "$root" | tail -3 | sed 's/^/     /'
    exit 1
  fi
  # cutoff 의 **날짜**까지 포함한다 — 같은 날 안에서 시각으로 다시 자른다.
  cutday="${CUTOFF%% *}"
  mapfile -t DIRS < <(printf '%s\n' "$root" | awk -v c="$cutday" \
    '/DIR /{ for(i=1;i<=NF;i++) if ($i ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) { if (c=="" || $i >= c) print $i } }')
  say "  훑을 폴더 ${#DIRS[@]}개${CUTOFF:+ (${cutday} 이후)}"
fi

if [ ${#DIRS[@]} -eq 0 ]; then
  say "  서버가 이미 최신이다 — 받을 폴더가 없다"
  exit 0
fi

# 폴더별 목록을 모아 "이름<TAB>MB<TAB>UTC폴더" 로 만든다.
#
# 🔴 **조회 실패를 "로그 없음"으로 바꾸지 마라.** 이 도구의 가장 나쁜 실패는
#    비행이 있었는데 없다고 보고하는 것이다. MAVFTP 는 간헐적으로 첫 시도가
#    실패한다(pymavlink 2.4.49 의 인스턴스 필드 버그 · HEARTBEAT 놓침) —
#    실측으로 물렸다. 폴더마다 두 번 시도하고, 그래도 안 되면 **시끄럽게 죽는다.**
LIST=""
listing_failed=0
for d in "${DIRS[@]}"; do
  out=""; ok=0
  for attempt in 1 2; do
    out=$(ssh -n -o BatchMode=yes -o ConnectTimeout=60 "$FC_HOST" \
          "cd /tmp && $FC_VENV fcfetch.py ls /fs/microsd/log/$d" 2>&1)
    # "err=0" 이 나와야 진짜 성공이다. 디렉토리가 없으면 err 가 붙어 돌아온다.
    if grep -q 'err=0' <<< "$out"; then ok=1; break; fi
    # 폴더 자체가 없는 것은 정상이다 (인자 없이 부르면 어제 폴더도 훑는다).
    if grep -qE 'err=(FileNotFound|[0-9]+)' <<< "$out"; then ok=1; break; fi
    [ "$attempt" = 1 ] && sleep 2
  done
  if [ "$ok" = 0 ]; then
    fail "$d 목록 조회 실패 (2회 시도)"
    printf '%s\n' "$out" | tail -3 | sed 's/^/     /'
    listing_failed=1
    continue
  fi
  # 한 줄: "      09_24_04.ulg             22.41M"
  add=$(printf '%s\n' "$out" | awk -v d="$d" '
    /\.ulg/ { name=$1; mb=$2; gsub("M","",mb); printf "%s\t%s\t%s\n", name, mb, d }')
  [ -n "$add" ] && LIST="$LIST$add"$'\n'
done
LIST=$(printf '%s' "$LIST" | sed '/^$/d')

if [ "$listing_failed" = 1 ] && [ -z "$LIST" ]; then
  fail "FC 목록을 못 읽었다 — 로그가 없는 것과 다르다. 브리지·USB 를 확인하고 다시 돌려라."
  exit 1
fi
if [ -z "$LIST" ]; then
  say "  그 날짜에 FC 로그가 없다: ${DIRS[*]}"
  exit 0
fi
say "  FC 에 $(printf '%s\n' "$LIST" | wc -l)개"

# 같은 날 안에서 **시각**으로 다시 자른다. 폴더 단위로는 cutoff 당일이 통째로
# 들어와 있기 때문이다.
if [ -n "$CUTOFF" ]; then
  before=$(printf '%s\n' "$LIST" | grep -c . || true)
  LIST=$(printf '%s\n' "$LIST" | python3 "$HERE/since.py" pick "$CUTOFF")
  after=$(printf '%s' "$LIST" | grep -c . || true)
  say "  서버 이후만: ${after}개 (${before}개 중 $((before-after))개는 이미 반영됨)"
  if [ "$after" = 0 ]; then
    say "  ✅ 서버가 이미 최신이다 — 새 비행이 없다"
    exit 0
  fi
fi

# ── 2. 크기 게이트 ──────────────────────────────────────────────────
WANT=$(printf '%s\n' "$LIST" | awk -F'\t' -v m="$MIN_MB" '$2+0 >= m')
SKIP=$(printf '%s\n' "$LIST" | awk -F'\t' -v m="$MIN_MB" '$2+0 <  m')
nwant=$(printf '%s' "$WANT" | grep -c . || true)
nskip=$(printf '%s' "$SKIP" | grep -c . || true)
biggest=$(printf '%s\n' "$SKIP" | awk -F'\t' '{if($2+0>m)m=$2+0}END{printf "%.2f", m+0}')

say "  받을 것 ${nwant}개 / ${MIN_MB}MB 미만 ${nskip}개 건너뜀 (그중 최대 ${biggest}MB)"
# 경계에 붙은 파일이 있으면 눈에 띄게 말한다 — 실비행을 놓치는 유일한 경로다.
awk -v b="$biggest" -v m="$MIN_MB" 'BEGIN{ if (b+0 > m*0.8) print "  ⚠️ 건너뛴 것 중 " b "MB 가 문턱에 가깝다. 놓친 것 같으면: ./qgc sync --min-size=0.5" }'

if [ "$nwant" = 0 ]; then say "  받을 것이 없다"; exit 0; fi

if [ "$DRY" = 1 ]; then
  say "== [dry] 받을 목록 =="
  printf '%s\n' "$WANT" | awk -F'\t' '{printf "   %s  %sMB  (%s)\n",$1,$2,$3}'
  exit 0
fi

# ── 3. 받기 ─────────────────────────────────────────────────────────
say "== FC → $FC_HOST =="
t0=$(date +%s)
got=0
while IFS=$'\t' read -r name mb d; do
  [ -n "$name" ] || continue
  dest="${d}_${name}"                     # 저장 이름은 리포 규약 그대로
  if [ -e "$LOCAL/$dest" ]; then
    printf '   · %-26s 이미 있음\n' "$dest"; continue
  fi
  # 🔴 `-n` 이 없으면 ssh 가 **이 while 루프의 stdin 을 통째로 삼킨다.** 그러면
  #    첫 파일만 받고 루프가 끝난다 — 실측으로 물렸다 (7개 중 1개만 받았다).
  #    같은 이유로 아래 scp 에도 `-n` 을 준다.
  if [ "$VOTE_N" -ge 3 ] 2>/dev/null; then
    cmd="$FC_VENV fcvote.py /fs/microsd/log/$d/$name $FC_LOGDIR/$dest $VOTE_N"
  else
    cmd="$FC_VENV fcfetch.py get /fs/microsd/log/$d/$name $FC_LOGDIR/$dest"
  fi
  if out=$(ssh -n -o BatchMode=yes -o ConnectTimeout=60 -o ServerAliveInterval=30 \
       "$FC_HOST" "cd /tmp && $cmd" 2>&1); then
    printf '   ✅ %-26s %sMB\n' "$dest" "$mb"; got=$((got+1))
    # 다수결 통계는 눈에 보여야 한다 — 표차가 아슬아슬하면 횟수를 늘려야 한다.
    if [ "$VOTE_N" -ge 3 ] 2>/dev/null; then
      printf '%s\n' "$out" | grep -E '의견 갈린|leave-one-out|⚠️' | sed 's/^ */      /'
    fi
  else
    # 🔴 실패 사유를 버리지 마라. 이걸 삼키면 "받기 실패" 다섯 글자만 남아
    #    원인을 손으로 재현해야 한다 — 실측으로 겪었다.
    printf '   ✗ %-26s 받기 실패\n' "$dest"
    printf '%s\n' "$out" | tail -4 | sed 's/^/        /'
  fi
done <<< "$WANT"
say "  ${got}개 받음 ($(( $(date +%s) - t0 ))초)"

# 브리지를 **여기서** 되살린다. 아래 단계는 FC 와 무관하므로 링크를 더 붙들
# 이유가 없다.
restore

# ── 4. 회수 ─────────────────────────────────────────────────────────
say "== $FC_HOST → 이 PC =="
mkdir -p "$LOCAL"
before=$(ls "$LOCAL"/*.ulg 2>/dev/null | wc -l)
while IFS=$'\t' read -r name mb d; do
  [ -n "$name" ] || continue
  dest="${d}_${name}"
  [ -e "$LOCAL/$dest" ] && continue
  scp -q -o BatchMode=yes -o ConnectTimeout=200 "$FC_HOST:$FC_LOGDIR/$dest" "$LOCAL/" </dev/null \
    || printf '   ✗ %s 회수 실패\n' "$dest"
done <<< "$WANT"
say "  로컬 $(ls "$LOCAL"/*.ulg 2>/dev/null | wc -l)개 (이전 ${before}개)"

# ── 5. 판정 ─────────────────────────────────────────────────────────
pick_python() {
  for c in "${QGCLOG_PYTHON:-}" "$REPO/.venv/bin/python" \
           "$REPO/venv-ardupilot/bin/python" python3; do
    [ -n "$c" ] || continue
    command -v "$c" >/dev/null 2>&1 && "$c" -c "import pyulog,numpy" >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}
PY="$(pick_python)" || { fail "pyulog 를 가진 python 이 없다 — PROCEDURE.md 2-0"; exit 1; }

say "== 판정 =="
cand=()
while IFS=$'\t' read -r name mb d; do
  [ -n "$name" ] || continue
  f="$LOCAL/${d}_${name}"
  [ -e "$f" ] && cand+=("$f")
done <<< "$WANT"

[ ${#cand[@]} -gt 0 ] || { say "  판정할 파일이 없다"; exit 0; }

send=()
while IFS=$'\t' read -r v why p; do
  [ -n "$v" ] || continue
  b=$(basename "$p")
  # uploadable.py 는 skip 사유를, keep 이면 배지를 준다. 여기서는 실제로 뜬
  # 것만 올린다 — 지상 시험은 로컬과 FC 에 남아 있고 언제든 볼 수 있다.
  if [ "$v" = "skip" ]; then
    printf '   − %-30s %s\n' "$b" "$why"
  elif grep -qw -- "$why" <<< "$UPLOAD_BADGES"; then
    printf '   ✅ %-30s %s\n' "$b" "$why"; send+=("$p")
  else
    printf '   − %-30s %s (안 올림)\n' "$b" "$why"
  fi
done < <("$PY" "$REPO/web/tools/uploadable.py" "${cand[@]}" 2>/dev/null)

# ── 6. 업로드 ───────────────────────────────────────────────────────
if [ ${#send[@]} -eq 0 ]; then
  say "== 올릴 비행이 없다 =="
  exit 0
fi

say "== 서버로 =="
ssh -o BatchMode=yes "$SERVER" "mkdir -p '$SERVER_LOGS'" || { fail "서버 접속 실패"; exit 1; }
if command -v rsync >/dev/null && ssh -o BatchMode=yes "$SERVER" 'command -v rsync' >/dev/null 2>&1; then
  rsync -a --ignore-existing --info=stats1 "${send[@]}" "$SERVER:$SERVER_LOGS/" || { fail "업로드 실패"; exit 1; }
else
  for f in "${send[@]}"; do scp -q "$f" "$SERVER:$SERVER_LOGS/" || fail "업로드 실패: $f"; done
fi

say "== 서버 반영 =="
ssh -o BatchMode=yes "$SERVER" "sudo systemctl restart $SERVER_UNIT" || fail "서비스 재시작 실패"
# 캐시를 굽는 동안 502 가 난다. 준비될 때까지 짧게 기다린다.
for _ in $(seq 1 12); do
  h=$(curl -s --max-time 20 "$PUBLIC_URL/api/health" 2>/dev/null)
  case "$h" in *'"ok":true'*) say "  $h"; break ;; esac
  sleep 5
done

say
say "✅ ${#send[@]}편 올렸다 — $PUBLIC_URL"
