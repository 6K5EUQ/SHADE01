#!/usr/bin/env bash
# 패치본 QGC 를 띄운다. AppImage 대신 직접 빌드한 바이너리를 쓴다.
#
# ⚠️ UDP 14550 을 QGC 가 잡는다. mav_bridge 나 분석 스크립트와 동시에 못 쓴다.

set -u
BIN="${QGC_BIN:-$HOME/SHADE01/qgc-5.1.4/bin/QGroundControl}"

if [[ ! -x "$BIN" ]]; then
  echo "빌드된 QGC 가 없다: $BIN" >&2
  echo "빌드 절차: $(dirname "$0")/BUILD.md" >&2
  exit 1
fi

exec "$BIN" "$@"
